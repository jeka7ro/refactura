{
  "manifest_version": 3,
  "name": "Factura/SPV — Conector Certificat USB ANAF",
  "description": "Conecteaza certificatul digital USB din Chrome la serviciul webserviced.anaf.ro/SPVWS2 pentru descarcarea automata a documentelor oficiale PDF/ZIP semnate de ANAF.",
  "version": "1.2.0",
  "permissions": ["tabs", "scripting", "cookies"],
  "host_permissions": [
    "https://*.anaf.ro/*",
    "https://webserviced.anaf.ro/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://refactura.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://refactura.up.railway.app/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
